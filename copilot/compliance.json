    "crypto":          {"NCA_ECC": ["2-8"], "CRA": ["AnnexI-I(2)(e)"], "NIS2": ["Art.21(2)(h)"], "DORA": ["Art.9"], "GDPR": ["Art.32"]},
    "tls":             {"NCA_ECC": ["2-8", "2-7"], "CRA": ["AnnexI-I(2)(e)", "AnnexI-I(2)(f)"], "NIS2": ["Art.21(2)(h)"], "DORA": ["Art.9"], "GDPR": ["Art.32"]},
    "config":          {"NCA_ECC": ["2-3", "1-6"], "CRA": ["AnnexI-I(2)(b)", "AnnexI-I(2)(j)"], "NIS2": ["Art.21(2)(e)"], "DORA": ["Art.9"], "GDPR": ["Art.25"]},
    "container":       {"NCA_ECC": ["2-3"], "CRA": ["AnnexI-I(2)(b)", "AnnexI-I(2)(j)"], "NIS2": ["Art.21(2)(e)"], "DORA": ["Art.9"]},
    "deserialization": {"NCA_ECC": ["2-15", "1-6"], "CRA": ["AnnexI-I(2)(a)", "AnnexI-I(2)(f)"], "NIS2": ["Art.21(2)(e)"], "DORA": ["Art.9"]},
    "xss":             {"NCA_ECC": ["2-15"], "CRA": ["AnnexI-I(2)(a)", "AnnexI-I(2)(f)"], "NIS2": ["Art.21(2)(e)"], "GDPR": ["Art.32"]},
    "supply_chain":    {"NCA_ECC": ["2-10", "4-1"], "CRA": ["AnnexI-II(1)", "Art.13(5)"], "NIS2": ["Art.21(2)(d)"], "DORA": ["Art.28"]}
  }
}
